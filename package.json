{
  "name": "lyreniq",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@11.25.0",
  "engines": {
    "node": "24.21.0",
    "pnpm": "11.25.0"
  },
  "scripts": {
    "dev": "pnpm --filter @lyreniq/desktop tauri dev",
